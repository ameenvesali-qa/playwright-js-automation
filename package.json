{
  "name": "playwright-js-automation",
  "version": "1.0.0",
  "description": "Playwright JS automation framework for SauceDemo UI and Restful-Booker API",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:api": "playwright test tests/api",
    "test:login": "playwright test tests/login.spec.js tests/negativeLogin.spec.js",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "test:chromium:list": "playwright test --project=chromium --reporter=list",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameenvesali-qa/playwright-js-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ameenvesali-qa/playwright-js-automation/issues"
  },
  "homepage": "https://github.com/ameenvesali-qa/playwright-js-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2"
  },
  "dependencies": {
    "dotenv": "^18.0.4"
  }
}
